datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  twoFactorEnabled Boolean @default(false)
  twoFactorEmailEnabled         Boolean @default(false)
  twoFactorSmsEnabled           Boolean @default(false)
  twoFactorAuthenticatorEnabled Boolean @default(false)
  twoFactorMethod  String   @default("EMAIL")
  twoFactorSecret  String?
  twoFactorPhone   String?
  twoFactorCode    String?
  twoFactorExpires DateTime?
  
  // Abunəlik məlumatları (Stripe)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?   @default("STARTER") // STARTER, PRO, ENTERPRISE

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  userId      String
  data        String   // JSON formatında furnitureLayers yadda saxlanılacaq
  wallColor   String   @default("#ffffff")
  floorColor  String   @default("#8c8c8c")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
